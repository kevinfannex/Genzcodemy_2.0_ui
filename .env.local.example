# Supabase (get these from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API (your friend's Next.js API repo, run separately)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001/api/v1

# Admin portal path — keep this out of any nav/sitemap/robots.
# Change it to something non-guessable before deploying.
NEXT_PUBLIC_ADMIN_PORTAL_SLUG=admin-portal


# Google Sheets API Configuration (Server-Side Only)
# Used for the Free Class Registration form submission.
# NEVER expose the private key or service account email to the frontend.
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
# Google private keys look like "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="your-private-key"
GOOGLE_SHEET_RANGE="Free Class Leads!A:L"
